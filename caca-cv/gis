SELECT waterways.gid, waterways.name, MIN(st_distance(waterways.geom, buildings.geom)) AS min_distance
FROM waterways, buildings
WHERE waterways.fclass = 'river' AND river waterways.name IS NOT NULL
GROUP BY waterways.gid, waterways.name

Upit se vrtio 45 minuta, a st_distance ne koristi spatial index.

SELECT waterways.gid, waterways.name, MIN(st_distance(waterways.geom, buildings.geom)) AS min_distance
FROM waterways
JOIN buildings ON st_dwithin(waterways.geom, buildings.geom, 4800)
WHERE waterways.fclass = 'river' AND river waterways.name IS NOT NULL
GROUP BY waterways.gid, waterways.name
ORDER BY waterways.gid;

Upit se vrtio 30 sekundi, bio je znatno brži zato što koristi navedeni index.

SELECT waterways.gid, waterways.name, MIN(st_distance(waterways.geom, buildings.geom)) AS min_distance
FROM waterways, buildings
WHERE waterways.fclass = 'river' AND buildings.geom && st_expand(waterways.geom, 500) AND river waterways.name IS NOT NULL
GROUP BY waterways.gid, waterways.name;

Upit se vrtio 19 sekundi i koristio je spatial index.

