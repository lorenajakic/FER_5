<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-8"><%= t('account_settings.title') %></h1>

  <div class="overflow-hidden rounded-xl bg-white shadow-sm">
    <div class="px-8 py-10">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
        <% input_classes = "block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-800 shadow-sm placeholder:text-gray-400 outline-none focus:outline-none focus-visible:outline-none focus-visible:outline-0 focus:border-slate-300 focus:ring-2 focus:ring-slate-100" %>
        <% label_classes = "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, t('account_settings.email'), class: label_classes %>
          <p class="text-sm text-gray-900"><%= resource.email %></p>
          <%= f.hidden_field :email %>
        </div>

        <hr class="border-gray-200">

        <div>
          <%= f.label :current_password, t('account_settings.current_password'), class: label_classes %>
          <%= f.password_field :current_password, autofocus: true, autocomplete: "current-password", class: input_classes %>
          <p class="mt-2 text-xs text-gray-500"><%= t('account_settings.current_password_hint') %></p>
        </div>

        <div>
          <%= f.label :password, t('account_settings.new_password'), class: label_classes %>
          <%= f.password_field :password, autocomplete: "new-password", class: input_classes %>
        </div>

        <div>
          <%= f.label :password_confirmation, t('account_settings.password_confirmation'), class: label_classes %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_classes %>
        </div>

        <div class="flex items-center gap-4 pt-2">
          <%= f.submit t('account_settings.save_changes'), class: "rounded-lg bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
          <%= link_to t('common.cancel'), profile_path, class: "text-sm font-semibold text-gray-700 hover:text-gray-900" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
