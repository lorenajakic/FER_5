<div id="<%= dom_id(message) %>" class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %> mb-3">
  <div class="max-w-[min(85%,28rem)] <%= message.role == 'user' ? 'bg-indigo-600 text-white' : 'bg-white border border-gray-200 text-gray-800' %> rounded-2xl px-5 py-2.5 shadow-sm">
    <% if message.processing? %>
      <div class="flex items-center gap-2 text-gray-400 py-1">
        <span class="flex gap-1 items-end">
          <span class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></span>
          <span class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></span>
          <span class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></span>
        </span>
      </div>
    <% else %>
      <div class="text-sm leading-relaxed break-words [overflow-wrap:anywhere] [&_hr]:my-4 [&_a]:underline [&_a]:font-medium <%= message.role == 'user' ? '[&_a]:text-white' : '[&_a]:text-blue-600 hover:[&_a]:text-blue-800' %>"><%= render_chat_markdown(message.content) %></div>
      <% if message.has_plan? %>
        <div class="mt-3 pt-3 border-t border-gray-100">
          <%= button_to trip_itinerary_path(message.trip),
                method: :patch,
                params: { plan_json: message.plan_json.to_json },
                class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700 transition" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
            <%= t("agent.chat.save_to_itinerary") %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <p class="text-[10px] mt-1 <%= message.role == 'user' ? 'text-indigo-300' : 'text-gray-400' %> text-right">
      <%= message.created_at.strftime("%H:%M") %>
    </p>
  </div>
</div>
