<div class="flex flex-col h-[400px] min-h-0 max-h-[calc(100vh-12rem)] lg:h-[calc(100vh-16rem)] lg:max-h-none bg-white border border-gray-200 rounded-2xl overflow-hidden">
  <%= turbo_stream_from "trip_#{trip.id}_chat" %>

  <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-4 space-y-1" id="chat_messages" data-controller="chat-scroll">
    <% if messages.empty? %>
      <div class="flex flex-col items-center justify-center h-full text-center text-gray-400">
        <svg class="h-10 w-10 mb-3 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <p class="text-sm font-medium"><%= t("agent.chat.empty_title") %></p>
        <p class="text-xs mt-1"><%= t("agent.chat.empty_hint") %></p>
      </div>
    <% else %>
      <%= render partial: "trips/chat_messages/message", collection: messages, as: :message %>
    <% end %>
  </div>

  <div class="shrink-0 border-t border-gray-100 p-3 bg-gray-50">
    <%= render "trips/chat_messages/form", trip: trip %>
  </div>
</div>
