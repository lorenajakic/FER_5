<%= turbo_frame_tag "chat_input_form" do %>
  <%= form_with url: trip_chat_messages_path(trip), method: :post, data: { controller: "chat-form" }, class: "space-y-2" do %>
    <div class="flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-3 py-2 focus-within:border-indigo-400 focus-within:ring-1 focus-within:ring-indigo-400">
      <%= text_area_tag :content, nil,
          rows: 2,
          required: true,
          placeholder: t("agent.chat.placeholder"),
          class: "flex-1 border-0 bg-transparent p-0 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-0 resize-none",
          data: { action: "keydown->chat-form#submitOnEnter", chat_form_target: "input" } %>
      <%= button_tag type: "submit", class: "shrink-0 self-center inline-flex items-center justify-center rounded-md bg-indigo-600 p-1.5 text-white hover:bg-indigo-500 active:bg-indigo-700 transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M3.105 2.288a.75.75 0 0 0-.826.95l1.414 4.926A1.5 1.5 0 0 0 5.135 9.25h6.115a.75.75 0 0 1 0 1.5H5.135a1.5 1.5 0 0 0-1.442 1.086l-1.414 4.926a.75.75 0 0 0 .826.95 28.897 28.897 0 0 0 15.293-7.154.75.75 0 0 0 0-1.115A28.897 28.897 0 0 0 3.105 2.288Z" />
        </svg>
      <% end %>
    </div>
  <% end %>
<% end %>
